      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The leading action for the current workflow scope; busy and disabled states remain explicit.",
      "html": "<button class=\"ds-primary\">Run part checks</button>",
      "css": ".ds-primary{font:14px/20px var(--intgral-font-sans);border-radius:var(--intgral-radius-control);cursor:pointer;min-height:40px;padding:9px 14px;border:0;background:var(--intgral-foreground);color:var(--intgral-background);font-weight:500;transition:background var(--intgral-duration-feedback),color var(--intgral-duration-feedback)}.ds-primary:hover:not(:disabled){background:var(--intgral-foreground-secondary)}.ds-primary:focus-visible{outline:2px solid var(--intgral-focus);outline-offset:3px;}.ds-primary:disabled{cursor:not-allowed;opacity:.5}@media(max-width:760px){.ds-primary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
