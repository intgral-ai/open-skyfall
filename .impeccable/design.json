      "css": ".ds-picker{display:flex;align-items:center;gap:8px;font:12px/18px var(--intgral-font-sans);color:var(--intgral-foreground-muted)}.ds-select{height:40px;width:240px;max-width:100%;min-width:0;padding:0 12px;border:1px solid var(--intgral-control-border);border-radius:var(--intgral-radius-control);font:13px/20px var(--intgral-font-sans);background:var(--intgral-surface-raised);color:var(--intgral-foreground)}.ds-select:focus-visible{outline:2px solid var(--intgral-focus);outline-offset:3px;}"
