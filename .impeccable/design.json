      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Part inspection\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Details</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Reference</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Checks</button></div>",
      "css": ".ds-tabs{display:flex;gap:24px;padding:0 20px;border-bottom:1px solid var(--intgral-border)}.ds-tab{min-height:44px;padding:8px 0;border:0;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:var(--intgral-foreground-muted);font:13px/20px var(--intgral-font-sans);cursor:pointer}.ds-tab[aria-selected=\"true\"]{color:var(--intgral-foreground);border-bottom-color:var(--intgral-foreground)}.ds-tab:hover{background:var(--intgral-selection)}.ds-tab:focus-visible{outline:2px solid var(--intgral-focus);outline-offset:3px;}"
